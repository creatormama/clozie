# Environment variables — NEVER upload to GitHub
.env
.env.local
.env*.local

# Expo
.expo/
dist/
node_modules/

# iOS / Android builds — CNG auto-generates these at root; never commit.
ios/
android/

# But DO commit native source inside local Expo modules (modules/<name>/ios/, /android/).
# Order matters: negation must come AFTER the ignore patterns above.
!modules/**/ios/
!modules/**/ios/**
!modules/**/android/
!modules/**/android/**

*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Mac
.DS_Store
